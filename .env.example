# =============================================================================
# IMPULATOR Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# All variables without defaults are REQUIRED.

# Application
APP_NAME=Impulator
DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=auto

# Server
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=7860

# -----------------------------------------------------------------------------
# Database (REQUIRED)
# -----------------------------------------------------------------------------
# Get your connection string from: Supabase Dashboard > Settings > Database
# Use the "Transaction Pooler" connection string (port 6543)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# IMPORTANT: The app will NOT start without this variable set.
# Local dev and HF Space should use the SAME Supabase instance.
DATABASE_URL=

# Direct connection for Alembic migrations (optional, port 5432)
# Falls back to DATABASE_URL if empty. Supabase recommends direct connections for DDL.
# Dashboard > Settings > Database > "Direct Connection" string
DIRECT_DATABASE_URL=

# Supabase project credentials (for future auth provider integration)
# Dashboard > Settings > General > Project ID
# URL = https://<project-id>.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
# Secret key (backend use) — Dashboard > API Keys > Secret keys
# Publishable key is for browser/frontend with RLS — NOT needed here
SUPABASE_SECRET_KEY=your-secret-key-here

# -----------------------------------------------------------------------------
# Executor (async job processing)
# -----------------------------------------------------------------------------
MAX_CONCURRENT_JOBS=10
JOB_TIMEOUT=3600

# Cache (in-memory LRU per function)
CACHE_SIZE=500
CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Azure Blob Storage (for result ZIPs and logs -- NOT the database)
# -----------------------------------------------------------------------------
AZURE_CONNECTION_STRING=
AZURE_CONTAINER=impulator

# -----------------------------------------------------------------------------
# Database pool configuration (Phase 19.3)
# -----------------------------------------------------------------------------
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=10
# DB_ECHO=false

# -----------------------------------------------------------------------------
# Shutdown configuration (Phase 19)
# -----------------------------------------------------------------------------
# SHUTDOWN_TIMEOUT=25

# -----------------------------------------------------------------------------
# Rate limiting (Phase 19)
# -----------------------------------------------------------------------------
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW=60
# RATE_LIMIT_MAX_JOBS=10
# RATE_LIMIT_MAX_BATCH=3

# -----------------------------------------------------------------------------
# httpx connection limits (Phase 19.1)
# -----------------------------------------------------------------------------
# CHEMBL_MAX_CONNECTIONS=30
# CHEMBL_MAX_PER_JOB=10

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:7860,http://localhost:8501,https://*.hf.space

# Security
ADMIN_API_KEY=
# REQUIRE_SESSION_VALIDATION=true  # from backend/config.py -- validate session IDs

# -----------------------------------------------------------------------------
# Additional settings from backend/config.py (defaults shown, uncomment to override)
# -----------------------------------------------------------------------------
# APP_VERSION=2.2.0-dev            # from backend/config.py
# TESTING=false                    # from backend/config.py -- CI compatibility (allows SQLite)
# MAX_BATCH_SIZE=1000              # from backend/config.py -- max compounds per batch

# External API endpoints (from backend/config.py)
# CHEMBL_API_URL=https://www.ebi.ac.uk/chembl/api/data
# PDB_API_URL=https://search.rcsb.org/rcsbsearch/v2/query
# API_TIMEOUT=60                   # timeout for external API calls (seconds)

# Storage paths (from backend/config.py)
# DATA_DIR=./data
# RESULTS_DIR=./data/results
